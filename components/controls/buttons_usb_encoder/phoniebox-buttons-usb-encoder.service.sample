[Unit]
Description=Phoniebox Buttons USB Encoder
After=mpd.service

[Service]
User=%USER%
Group=%USER%
Restart=always
RestartSec=5
WorkingDirectory=%INSTALL_DIR%
ExecStart=%VENV_PATH%/bin/python3 %INSTALL_DIR%/components/controls/buttons_usb_encoder/buttons_usb_encoder.py

[Install]
WantedBy=multi-user.target
